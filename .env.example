# 复制为 .env，填写本地账号和密钥；不要提交 .env。
# Postgres（与 docker-compose.yml 一致）
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=<db-user>
DATABASE_PASSWORD=<db-password>
DATABASE_NAME=<db-name>

# pgAdmin
PGADMIN_DEFAULT_EMAIL=<admin-email>
PGADMIN_DEFAULT_PASSWORD=<admin-password>

# MinIO
MINIO_ROOT_USER=<minio-user>
MINIO_ROOT_PASSWORD=<minio-password>

# JWT / 演示登录
JWT_SECRET=<random-long-secret>
DEMO_USERNAME=<demo-user>
DEMO_PASSWORD=<demo-password>

# OpenAI 兼容 Embedding / Chat（阿里云 DashScope compatible-mode）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=<api-key>
EMBEDDING_MODEL=text-embedding-v3
CHAT_MODEL=qwen-plus
# 须与 text-embedding-v3 输出及 init.sql 中 vector(N) 一致
EMBEDDING_DIMS=1024

# 切块
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 服务
PORT=3000
